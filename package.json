{
  "name": "Zephyr PIXI.JS",
  "version": "0.64",
  "description": "Zephyr PIXI.JS",
  "main": "code.js",
  "scripts": {
    "dev": "webpack serve --mode=development",
    "dev:watch": "webpack --mode=development --watch",
    "watch": "npm run build -- --watch",
    "build": "webpack --mode=production",
    "start": "serve dist",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "lint": "eslint --fix \"src/**/*.{ts,tsx,js,jsx}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "figma",
    "plugin"
  ],
  "author": "Denis Gusarov",
  "license": "MIT",
  "dependencies": {
    "@figma/plugin-typings": "^1.58.0",
    "@types/node": "^16.7.1",
    "@types/pixi.js": "^4.8.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.6.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "base64-inline-loader": "^2.0.1",
    "css-loader": "^6.8.1",
    "daisyui": "^3.9.4",
    "eslint": "^8.50.0",
    "eslint-config": "^0.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "html-inline-script-webpack-plugin": "^3.1.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.1.6",
    "jszip": "^3.10.1",
    "lint-staged": "^15.2.10",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prettier": "3.3.3",
    "serve": "^14.2.1",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.3.5",
    "ts-loader": "^9.4.4",
    "typescript": "^5.6.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
